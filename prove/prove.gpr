--  Proof harness for Beacon.Queue.
--
--  GNATprove does not analyze a generic on its own, only its instances.
--  Running it on beacon.gpr therefore proves nothing about Beacon.Queue.
--  This project instantiates the queue with a depth the prover cannot
--  see (see queue_proof.ads), so the result holds for every Depth.
--
--     gnatprove -P prove/prove.gpr -XBEACON_NETWORK=no --mode=all

with "../beacon.gpr";

project Prove is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Local_Configuration_Pragmas use "../gnat.adc";
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatyg", "-gnatyM100");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--timeout=30", "-j0", "--checks-as-errors=on");
   end Prove;
end Prove;
